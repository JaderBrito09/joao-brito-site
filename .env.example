# Configurações Gerais do Servidor
PORT=80
NODE_ENV=production

# URLs e Identificação do Site
SITE_URL=https://www.jbritopensamentos.com.br
SITE_NAME="João de Brito Freires - Pensamentos & Poesia"

# Formspree / Web3Forms / Custom Webhook para Formulário de Contato
CONTACT_FORM_ENDPOINT=https://formspree.io/f/SUA_CHAVE_AQUI

# Serviço de Newsletter (Brevo / Mailchimp / ConvertKit / Custom)
NEWSLETTER_ENDPOINT=https://api.brevo.com/v3/contacts
NEWSLETTER_API_KEY=sua_api_key_aqui

# GitOps & Easypanel Auto-Deploy Trigger
EASYPANEL_WEBHOOK_URL=https://easypanel.seu-dominio.com/api/deploy/webhook_token_aqui
GITHUB_REPOSITORY=JaderBrito09/joao-brito-site
HERMES_AGENT_AUTO_DEPLOY=true

# Analytics & SEO (Opcional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
